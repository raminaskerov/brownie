# Required for Jev steering (the default).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# One Gemini key can serve both LLM steering and field-text generation.
GEMINI_API_KEY=

# Used by --steerer llm. Comma-separated fallbacks, at most two.
STEERING_MODEL=gemini-3.6-flash
STEERING_MODEL_FALLBACKS=gemini-3.5-flash-lite
STEERING_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional role-specific key override; leave empty to use GEMINI_API_KEY.
STEERING_MODEL_API_KEY=

# Used only after either steerer selects TYPE_TEXT.
# Existing TEXT_MODEL_API_KEY remains supported and overrides GEMINI_API_KEY.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
TEXT_MODEL=gemini-3.5-flash-lite
TEXT_MODEL_FALLBACKS=gemini-3.1-flash-lite
